// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum RoomSize {
  NORMAL
  FAMILY
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  ARCHIVED
}

enum RoomChargeKind {
  ROOM_FEE
  WATER
  FOOD
  RESTAURANT_ORDER
  OTHER
}

enum OrderPaymentMethod {
  CASH
  ROOM_CHECKOUT
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  ROOM_FOLIO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(uuid())
  name      String
  jobTitle  String   @default("Waiter")
  email     String   @unique
  password  String
  avatarUrl String?
  role      Role     @default(EMPLOYEE)
  isOnline  Boolean  @default(false)
  orders    Order[]  @relation("WaiterOrders")
  servedOrders Order[] @relation("ServedOrders")
  paidOrders Order[] @relation("OrderPaidBy")
  shifts    EmployeeShift[]
  tasksAssigned TaskAssignment[] @relation("TaskAssignmentEmployee")
  tasksCreated  Task[] @relation("TaskCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  assignments  TaskAssignment[]
  createdById  String?
  createdBy    User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, dueAt])
}

model TaskAssignment {
  taskId     String
  employeeId String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   User     @relation("TaskAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

model EmployeeShift {
  id         String    @id @default(uuid())
  employeeId String
  employee   User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkedInAt DateTime @default(now())
  checkedOutAt DateTime?
  createdAt DateTime @default(now())
  breaks    ShiftBreak[]

  @@index([employeeId, checkedInAt])
}

model ShiftBreak {
  id              String        @id @default(uuid())
  employeeShiftId String
  employeeShift   EmployeeShift @relation(fields: [employeeShiftId], references: [id], onDelete: Cascade)
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  createdAt       DateTime      @default(now())

  @@index([employeeShiftId, endedAt])
}

model Table {
  id          String      @id @default(uuid())
  tableNumber Int         @unique
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Room {
  id         String     @id @default(uuid())
  roomNumber Int        @unique
  size       RoomSize   @default(NORMAL)
  usageFee   Decimal    @default(0) @db.Decimal(10, 2)
  facilities String[]   @default([])
  status     RoomStatus @default(AVAILABLE)
  stays      RoomStay[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model RoomStay {
  id              String        @id @default(uuid())
  roomId          String
  room            Room          @relation(fields: [roomId], references: [id])
  primaryGuestName String
  occupants       RoomOccupant[]
  checkedInAt     DateTime      @default(now())
  checkedOutAt    DateTime?
  charges         RoomCharge[]
  orders          Order[]
  createdAt       DateTime      @default(now())

  @@index([roomId, checkedOutAt])
}

model RoomOccupant {
  id        String   @id @default(uuid())
  stayId    String
  stay      RoomStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
}

model RoomCharge {
  id          String         @id @default(uuid())
  stayId      String
  stay        RoomStay       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  orderId     String?        @unique
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind        RoomChargeKind
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(10, 2)
  amount      Decimal        @db.Decimal(10, 2)
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())

  @@index([stayId, occurredAt])
}

model Category {
  id    String     @id @default(uuid())
  name  String     @unique
  items MenuItem[]
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  allergens   String[] @default([])
  allergensMy String[] @default([])
  allergensTh String[] @default([])
  dietaryInfo String[] @default([])
  dietaryInfoMy String[] @default([])
  dietaryInfoTh String[] @default([])
  availableExtras String[] @default([])
  availableExtrasMy String[] @default([])
  availableExtrasTh String[] @default([])
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id])
  roomStayId  String?
  roomStay    RoomStay?   @relation(fields: [roomStayId], references: [id], onDelete: SetNull)
  paymentMethod OrderPaymentMethod @default(CASH)
  paymentStatus OrderPaymentStatus @default(UNPAID)
  paidAt        DateTime?
  paidById      String?
  paidBy        User?       @relation("OrderPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  roomCharge  RoomCharge?
  waiterId    String
  waiter      User        @relation("WaiterOrders", fields: [waiterId], references: [id])
  servedById  String?
  servedBy    User?       @relation("ServedOrders", fields: [servedById], references: [id], onDelete: SetNull)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id])
  quantity          Int
  unitPrice         Decimal  @db.Decimal(10, 2)
  removeIngredients String? // e.g. "No peanuts, No onions"
  addExtras         String? // e.g. "Extra garlic sauce, Extra side salad"
  selectedAllergens String[] @default([])
  specialNotes      String?
  subtotal          Decimal  @db.Decimal(10, 2)
}
