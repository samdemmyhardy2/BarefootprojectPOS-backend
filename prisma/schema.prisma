// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
  OVAL
  BOOTH
  BAR
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  ROOM_SERVICE
  PICKUP
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  ARCHIVED
}

enum InboundEmailStatus {
  PROCESSED
  DUPLICATE
  FAILED
  SKIPPED
  PENDING
  PROCESSING
}

enum RoomChargeKind {
  ROOM_FEE
  WATER
  FOOD
  RESTAURANT_ORDER
  OTHER
}

enum OrderPaymentMethod {
  CASH
  CARD
  PROMPTPAY
  ROOM_CHECKOUT
}

enum RoomPaymentMethod {
  CASH
  CARD
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  ROOM_FOLIO
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum PrintJobStatus {
  PENDING
  RENDERING
  PRINTING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(uuid())
  name      String
  jobTitle  String   @default("Waiter")
  email     String   @unique
  password  String
  avatarUrl String?
  role      Role     @default(EMPLOYEE)
  isOnline  Boolean  @default(false)
  orders    Order[]  @relation("WaiterOrders")
  servedOrders Order[] @relation("ServedOrders")
  paidOrders Order[] @relation("OrderPaidBy")
  roomPayments RoomPayment[] @relation("RoomPaymentReceiver")
  shifts    EmployeeShift[]
  tasksAssigned TaskAssignment[] @relation("TaskAssignmentEmployee")
  tasksCreated  Task[] @relation("TaskCreator")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantSetting {
  id         String   @id @default("restaurant")
  name       String   @default("Table & Thyme")
  logoUrl    String?
  vatPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus @default(TODO)
  dueAt        DateTime?
  assignments  TaskAssignment[]
  createdById  String?
  createdBy    User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, dueAt])
}

model TaskAssignment {
  taskId     String
  employeeId String
  assignedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   User     @relation("TaskAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

model EmployeeShift {
  id         String    @id @default(uuid())
  employeeId String
  employee   User      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkedInAt DateTime @default(now())
  checkedOutAt DateTime?
  createdAt DateTime @default(now())
  breaks    ShiftBreak[]

  @@index([employeeId, checkedInAt])
}

model ShiftBreak {
  id              String        @id @default(uuid())
  employeeShiftId String
  employeeShift   EmployeeShift @relation(fields: [employeeShiftId], references: [id], onDelete: Cascade)
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  createdAt       DateTime      @default(now())

  @@index([employeeShiftId, endedAt])
}

model FloorSection {
  id        String   @id @default(uuid())
  name      String
  position  Int
  tables    Table[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([position])
}

model Table {
  id          String      @id @default(uuid())
  tableNumber String      @unique
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  shape       TableShape  @default(RECTANGLE)
  positionX   Int         @default(0)
  positionY   Int         @default(0)
  width       Int         @default(2)
  height      Int         @default(2)
  sectionId   String
  section     FloorSection @relation(fields: [sectionId], references: [id])
  assignedRoomStays  RoomStay[]  @relation("TableRoomAssignments")
  orders      Order[]
  bills       TableBill[]
  splits      TableSplit[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sectionId])
}

model Room {
  id         String     @id @default(uuid())
  roomNumber String     @unique
  status     RoomStatus @default(AVAILABLE)
  stays      RoomStay[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model RoomStay {
  id              String        @id @default(uuid())
  roomId          String?
  room            Room?         @relation(fields: [roomId], references: [id])
  primaryGuestName String
  guestEmail      String?
  bookingSource   String?
  confirmationNumber String?
  sourceReservationId String?
  cloudbedsReservationId String?
  roomType        String?
  assignmentReason String?
  adults          Int?
  children        Int?
  nights          Int?
  currency        String?
  averageNightlyRate Decimal? @db.Decimal(12, 2)
  grandTotal      Decimal?      @db.Decimal(12, 2)
  depositAmount   Decimal?      @db.Decimal(12, 2)
  amountPaid      Decimal?      @db.Decimal(12, 2)
  balanceDue      Decimal?      @db.Decimal(12, 2)
  payment         Json?
  nightlyRates    ReservationNight[]
  occupants       RoomOccupant[]
  checkedInAt     DateTime      @default(now())
  expectedCheckoutAt DateTime?
  checkedOutAt    DateTime?
  cancelledAt     DateTime?
  guestNotes      String?
  cashOnly        Boolean       @default(false)
  chargeLimit     Decimal?      @db.Decimal(10, 2)
  charges         RoomCharge[]
  payments        RoomPayment[]
  orders          Order[]
  assignedTables  Table[]       @relation("TableRoomAssignments")
  tableSplits     TableSplit[]
  emails          InboundEmail[]
  createdAt       DateTime      @default(now())

  @@unique([bookingSource, confirmationNumber])
  @@index([roomId, checkedOutAt])
  @@index([sourceReservationId])
  @@index([cloudbedsReservationId])
}

model EmailSyncRun {
  id                      String         @id @default(uuid())
  trigger                 String
  status                  String
  startedAt               DateTime       @default(now())
  finishedAt              DateTime?
  imapConnected           Boolean        @default(false)
  scanned                 Int            @default(0)
  discovered              Int            @default(0)
  nested                  Int            @default(0)
  duplicates              Int            @default(0)
  confirmed               Int            @default(0)
  modified                Int            @default(0)
  cancelled               Int            @default(0)
  payments                Int            @default(0)
  imported                Int            @default(0)
  updated                 Int            @default(0)
  canceled                Int            @default(0)
  skipped                 Int            @default(0)
  unmatched               Int            @default(0)
  failed                  Int            @default(0)
  parts                   Int            @default(0)
  attachments             Int            @default(0)
  maxDepth                Int            @default(0)
  uniqueEmails            Int            @default(0)
  processedAttachments    Int            @default(0)
  failedAttachments       Int            @default(0)
  unprocessedAttachments  Int            @default(0)
  lastUid                 Int?
  error                   String?
  emails                  InboundEmail[]
  createdAt               DateTime       @default(now())

  @@index([startedAt])
}

model InboundEmail {
  id                 String             @id @default(uuid())
  messageId          String             @unique
  mailbox            String
  uid                Int?
  subject            String?
  fromAddress        String?
  receivedAt         DateTime?
  rawMime            String             @db.Text
  status             InboundEmailStatus
  error              String?
  confirmationNumber String?
  source             String?
  noticeKind         String?
  noticeAt           DateTime?
  outcome            String?
  guestName          String?
  cloudbedsReservationId String?
  parentMessageId    String?
  nestingDepth       Int?
  attachmentFilename String?
  attemptLog         Json?
  attempts           Int                @default(0)
  nextAttemptAt      DateTime?
  stayId             String?
  stay               RoomStay?          @relation(fields: [stayId], references: [id], onDelete: SetNull)
  syncRunId          String?
  syncRun            EmailSyncRun?      @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  processedAt        DateTime?

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([confirmationNumber])
  @@index([cloudbedsReservationId])
  @@index([syncRunId])
}

model ReservationNight {
  id       String   @id @default(uuid())
  stayId   String
  stay     RoomStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  night    DateTime @db.Date
  amount   Decimal  @db.Decimal(12, 2)
  currency String

  @@index([stayId, night])
}

model RoomOccupant {
  id        String   @id @default(uuid())
  stayId    String
  stay      RoomStay @relation(fields: [stayId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
}

model CommissionItem {
  id         String       @id @default(uuid())
  name       String
  price      Decimal      @db.Decimal(10, 2)
  commission Decimal      @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())
  charges    RoomCharge[]
}

model RoomCharge {
  id          String         @id @default(uuid())
  stayId      String
  stay        RoomStay       @relation(fields: [stayId], references: [id], onDelete: Cascade)
  orderId     String?        @unique
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind        RoomChargeKind
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(10, 2)
  amount      Decimal        @db.Decimal(10, 2)
  commissionItemId String?
  commissionItem   CommissionItem? @relation(fields: [commissionItemId], references: [id], onDelete: SetNull)
  commissionAmount Decimal?  @db.Decimal(10, 2)
  signedByName String?
  signatureData String?      @db.Text
  occurredAt  DateTime       @default(now())
  settledAt   DateTime?
  billId      String?
  billNumber  Int?
  lines       Json?
  createdAt   DateTime       @default(now())

  @@index([stayId, occurredAt])
}

model RoomPayment {
  id         String            @id @default(uuid())
  stayId     String
  stay       RoomStay          @relation(fields: [stayId], references: [id], onDelete: Cascade)
  amount     Decimal           @db.Decimal(10, 2)
  method     RoomPaymentMethod
  note       String?
  receivedById String?
  receivedBy User?             @relation("RoomPaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  paidAt     DateTime          @default(now())
  createdAt  DateTime          @default(now())

  @@index([stayId, paidAt])
}

model Category {
  id    String     @id @default(uuid())
  name  String     @unique
  items MenuItem[]
}

model MenuItem {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  manualPrice Boolean     @default(false)
  imageUrl    String?
  allergens   String[] @default([])
  allergensMy String[] @default([])
  allergensTh String[] @default([])
  dietaryInfo String[] @default([])
  dietaryInfoMy String[] @default([])
  dietaryInfoTh String[] @default([])
  availableExtras String[] @default([])
  availableExtrasMy String[] @default([])
  availableExtrasTh String[] @default([])
  position    Int         @default(0)
  categoryId  String
  prepStation PrepStation @default(KITCHEN)
  category    Category    @relation(fields: [categoryId], references: [id])
  modifierGroups MenuItemModifierGroup[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, position])
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum PrepStation {
  KITCHEN
  BAR
  NONE
}

enum ModifierMadeAt {
  SAME_AS_DISH
  KITCHEN
  BAR
}

enum PrepTicketStatus {
  PENDING
  PREPARING
  READY
}

model ModifierGroup {
  id             String                  @id @default(uuid())
  name           String
  nameMy         String                  @default("")
  nameTh         String                  @default("")
  category       String                  @default("General")
  icon           String                  @default("Utensils")
  appearance     String                  @default("CHECKBOX")
  madeAt         ModifierMadeAt          @default(SAME_AS_DISH)
  required       Boolean                 @default(false)
  selectionType  ModifierSelectionType   @default(MULTIPLE)
  minPicks       Int                     @default(0)
  maxPicks       Int                     @default(1)
  includedPicks  Int                     @default(0)
  extraPickPrice Decimal                 @default(0) @db.Decimal(10, 2)
  allowDuplicates Boolean                @default(false)
  position       Int                     @default(0)
  options        ModifierOption[]
  openedByOptions ModifierOption[] @relation("ModifierOptionOpensGroup")
  menuItems      MenuItemModifierGroup[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([category, position])
}

model ModifierOption {
  id              String          @id @default(uuid())
  groupId         String
  group           ModifierGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  nameMy          String          @default("")
  nameTh          String          @default("")
  priceAdjustment Decimal         @default(0) @db.Decimal(10, 2)
  defaultSelected Boolean         @default(false)
  active          Boolean         @default(true)
  position        Int             @default(0)
  opensGroupId    String?
  opensGroup      ModifierGroup?  @relation("ModifierOptionOpensGroup", fields: [opensGroupId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([groupId, position])
}

model MenuItemModifierGroup {
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  groupId    String
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position   Int          @default(0)

  @@id([menuItemId, groupId])
  @@index([groupId, position])
}

model Order {
  id          String      @id @default(uuid())
  number      Int         @unique
  type        OrderType   @default(DINE_IN)
  customerName String?
  customerPhone String?
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableSplitId String?
  tableSplit  TableSplit? @relation(fields: [tableSplitId], references: [id], onDelete: SetNull)
  tableSnapshot Json?
  roomStayId  String?
  roomStay    RoomStay?   @relation(fields: [roomStayId], references: [id], onDelete: SetNull)
  roomGuestsSnapshot Json?
  paymentMethod OrderPaymentMethod @default(CASH)
  paymentStatus OrderPaymentStatus @default(UNPAID)
  paidAt        DateTime?
  paidById      String?
  paidBy        User?       @relation("OrderPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  roomCharge  RoomCharge?
  waiterId    String
  waiter      User        @relation("WaiterOrders", fields: [waiterId], references: [id])
  servedById  String?
  servedBy    User?       @relation("ServedOrders", fields: [servedById], references: [id], onDelete: SetNull)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  vatPercent  Decimal     @default(0) @db.Decimal(5, 2)
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  items       OrderItem[]
  prepTickets OrderPrepTicket[]
  printJobs   PrintJob[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, status, createdAt])
  @@index([tableSplitId])
}

model TableSplit {
  id         String    @id @default(uuid())
  tableId    String
  table      Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  label      String
  roomStayId String?
  roomStay   RoomStay? @relation(fields: [roomStayId], references: [id], onDelete: SetNull)
  position   Int       @default(0)
  orders     Order[]
  createdAt  DateTime  @default(now())

  @@unique([tableId, label])
  @@index([tableId])
}

model OrderPrepTicket {
  id          String           @id @default(uuid())
  orderId     String
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station     PrepStation
  status      PrepTicketStatus @default(PENDING)
  items       Json
  preparingAt DateTime?
  readyAt     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orderId, station])
  @@index([station, status, createdAt])
}

model TableBill {
  id            String    @id @default(uuid())
  tableId       String
  table         Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  number        Int
  status        String
  method        String?
  stayId        String?
  amount        Decimal   @db.Decimal(10, 2)
  vatPercent    Decimal   @default(0) @db.Decimal(5, 2)
  signedByName  String?
  signatureData String?   @db.Text
  paidAt        DateTime?
  chargeId      String?
  lines         Json
  createdAt     DateTime  @default(now())

  @@index([tableId, status])
}

model Printer {
  id             String    @id @default(uuid())
  name           String
  manufacturer   String    @default("")
  model          String    @default("")
  ipAddress      String
  macAddress     String    @default("")
  port           Int       @default(9100)
  connectionType String    @default("RAW")
  paperWidthMm   Int       @default(80)
  resolutionDpi  Int       @default(203)
  isDefault      Boolean   @default(false)
  enabled        Boolean   @default(true)
  purpose        String    @default("RECEIPT")
  lastSeenAt     DateTime?
  lastCheckedAt  DateTime?
  lastCheckOk    Boolean?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  jobs           PrintJob[]

  @@index([enabled, isDefault])
}

model PrintJob {
  id             String         @id @default(uuid())
  orderId        String?
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printerId      String
  printer        Printer        @relation(fields: [printerId], references: [id], onDelete: Cascade)
  requestedById  String
  idempotencyKey String?        @unique
  status         PrintJobStatus @default(PENDING)
  error          String?
  dryRun         Boolean        @default(false)
  retryCount     Int            @default(0)
  renderedAt     DateTime?
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model ClientSubmission {
  id        String   @id @default(uuid())
  scope     String
  key       String
  userId    String
  response  Json
  createdAt DateTime @default(now())

  @@unique([scope, key])
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId        String?
  menuItem          MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemSnapshot      Json?
  quantity          Int
  unitPrice         Decimal  @db.Decimal(10, 2)
  removeIngredients String? // e.g. "No peanuts, No onions"
  addExtras         String? // e.g. "Extra garlic sauce, Extra side salad"
  selectedAllergens String[] @default([])
  modifierSelections Json     @default("[]")
  specialNotes      String?
  subtotal          Decimal  @db.Decimal(10, 2)
  removedAt         DateTime?
  removalReason     String?
}
